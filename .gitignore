# Environments
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# data/raw/ is DVC-tracked (see data/raw.dvc) -- DVC auto-manages its ignore
# rule in data/.gitignore, nothing needed here for it.
# data/processed/ is a regenerable cache (not DVC-tracked, not git-tracked).
data/processed/*

# Trained artifacts / generated reports & figures
outputs/models/*
outputs/reports/*
outputs/figures/*
outputs/kaggle_run/*
outputs/sweep/*

# Hydraulic sensor-fusion experiment (see HYDRAULIC_PLAN.md): raw data is
# Kaggle-only (not DVC-tracked, unlike CWRU's data/raw/ -- no local copy
# exists this session), processed cache + generated artifacts are
# regenerable, same as the CWRU paths above.
data/hydraulic_raw/*
data/hydraulic_processed/*
outputs/hydraulic_models/*
outputs/hydraulic_reports/*
outputs/hydraulic_figures/*
outputs/hydraulic_kaggle_run/*

# Domain adaptation experiment (see DOMAIN_ADAPTATION_PLAN.md): both raw
# datasets are Kaggle-only (CWRU already covered above via data/raw/,
# Paderborn attached as a Kaggle input dataset, never downloaded in full
# locally), processed cache + generated artifacts are regenerable, same
# pattern as CWRU/hydraulic above. pu_dev_sample is an optional,
# never-required local dev fixture (see config's pu_root_local) -- tests
# use synthetic .mat files instead, so this is normally empty/absent.
data/da_processed/*
data/pu_dev_sample/*
outputs/da_models/*
outputs/da_reports/*
outputs/da_figures/*
outputs/domain_adaptation_kaggle_run/*

# ...but keep the empty directories themselves tracked
!data/processed/.gitkeep
!data/hydraulic_raw/.gitkeep
!data/hydraulic_raw/README.md
!data/hydraulic_processed/.gitkeep
!data/da_processed/.gitkeep
!outputs/**/.gitkeep

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/

# Rescue pulls from the rented GPU box: keep the EVIDENCE (metrics json,
# per-window prediction csv, figures, run logs) under version control --
# losing exactly those is what made the 2026-09-17 reproduction failure
# undiagnosable. The model binaries are large and are deliberately not
# tracked; they live on disk in outputs/server_rescue/ only.
outputs/server_rescue/**/*.pt
outputs/server_rescue/**/*.npz
outputs/server_rescue/**/.*.pt.*

# Paderborn condensed store (437MB, 33 bearing codes, vibration_1 @ 12kHz
# float32). Built by a Kaggle kernel from the 9.7GB raw dataset -- see
# src/domain_adaptation/data/prepare_pu.py. Not tracked, but do NOT delete
# it: regenerating it costs a Kaggle run, and it is the only local copy.
data/pu/*
deploy/volumes/
deploy/.env
outputs/envelope_cache/*

# remote/box (see remote/README.md): the current rental's IP and host key
# change every rental; pulled vault results follow the server_rescue rule
# (evidence tracked, binaries not).
remote/.box.env
remote/.known_hosts
outputs/remote_runs/**/*.pt
outputs/remote_runs/**/*.npz
outputs/remote_runs/**/*.npy
# Window-feature caches built on the box (regenerable in seconds there; the
# vault keeps a copy under projects/<project>/outputs/)
outputs/wp3/cache/
outputs/wp5/cache/
outputs/wp10/*.csv.gz
outputs/wp13/cache/
