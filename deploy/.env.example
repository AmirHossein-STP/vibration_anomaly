# copy to deploy/.env and edit
REGISTRY=registry.example.com/team      # where `deploy/release.sh` pushes and the server pulls from
TAG=dev                                 # image tag; release.sh sets it to the git commit
HOST_UID=1000                           # `id -u` of the user that owns the data folders
HOST_GID=1000                           # `id -g`
DATA_DIR=./volumes/data
MODELS_DIR=./volumes/models
