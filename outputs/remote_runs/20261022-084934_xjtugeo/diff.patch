+    seal(ddir, None, exam_of(cfg))
+    m.update(sealed=True, pinned=True, status="complete")
+    m["history"].append({"at": now(), "by": socket.gethostname(), "event": "pinned and sealed"})
+    save_manifest(ddir, m)
+    write_source_md(ddir, m)
+    print(f"{name}: pinned and sealed -> {ddir}", flush=True)
+    return m
 
 
