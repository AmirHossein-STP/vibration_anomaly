+def pin(name: str, cfg: dict, ddir: Path, m: dict, specs: list[FileSpec]) -> dict:
+    """Record what the publisher serves, byte for byte, without downloading it."""
+    if cfg["role"] != "sealed":
+        raise FetchError(f"{name}: stage pin is only for sealed datasets")
+    for s in specs:
